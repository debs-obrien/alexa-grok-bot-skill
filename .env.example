# Local server
PORT=43127
NODE_ENV=development

# Signature verification — set to 1 ONLY for local unit tests / curl fixtures.
# Production / Cloudflare Worker MUST leave this unset (fail closed).
DEV_SKIP_VERIFY=1

# Required in production (Worker rejects all requests if unset). Optional for local mock mode.
# SKILL_APPLICATION_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# CoS Grok Bot webhook (fire-and-forget wake). Leave unset or set MOCK_COS=1 for mock mode.
# COS_WEBHOOK_URL=https://<your-bot-webhook-url>
# COS_WEBHOOK_KEY=your-sender-key
MOCK_COS=1

# Wake POST timeout in ms (keep well under Alexa's ~8s final-response limit)
COS_WEBHOOK_TIMEOUT_MS=6000

# Cloudflare: use `npx wrangler secret put COS_WEBHOOK_URL` and
# `npx wrangler secret put COS_WEBHOOK_KEY` — do not put secrets in wrangler.toml.
# Alexa skill endpoint after deploy: https://<worker>.workers.dev/alexa
